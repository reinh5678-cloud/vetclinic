# Copia este archivo a ".env" (gitignored) y ajusta los valores.
# docker compose lo lee automáticamente.
POSTGRES_DB=vetclinic
POSTGRES_USER=vetapp
POSTGRES_PASSWORD=vetpass123

# Clave de firma JWT (mínimo 32 caracteres). Cambiar en producción.
JWT_KEY=SuperSecretKey_VetClinic_2026_CambiarEnProduccion_MustBeAtLeast32Chars
